if(NOT DEFINED CHECK OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "CHECK and TEST_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(valid "${TEST_DIR}/valid.json")
set(invalid "${TEST_DIR}/invalid.json")
set(missing "${TEST_DIR}/missing.gm3dproject")
file(WRITE "${valid}" "{\"name\":\"Test\",\"entities\":[]}")
file(WRITE "${invalid}" "{\"entities\":[{\"id\":4},{\"id\":4}]}")
file(WRITE "${missing}" "{\"format\":\"GM3DStudioProject\",\"version\":1,\"assets\":[{\"type\":\"model\",\"path\":\"missing.obj\"}]}")
execute_process(COMMAND "${CHECK}" scene "${valid}" RESULT_VARIABLE ok OUTPUT_VARIABLE ok_output ERROR_VARIABLE ok_error)
execute_process(COMMAND "${CHECK}" scene "${invalid}" RESULT_VARIABLE bad OUTPUT_VARIABLE bad_output ERROR_VARIABLE bad_error)
execute_process(COMMAND "${CHECK}" project "${missing}" RESULT_VARIABLE absent OUTPUT_VARIABLE absent_output ERROR_VARIABLE absent_error)
execute_process(COMMAND "${CHECK}" export "${valid}" "${TEST_DIR}/export" RESULT_VARIABLE exported OUTPUT_VARIABLE export_output ERROR_VARIABLE export_error)
file(REMOVE "${valid}" "${invalid}" "${missing}")
if(NOT ok EQUAL 0 OR NOT ok_output MATCHES "OK")
    message(FATAL_ERROR "Valid scene check failed: ${ok} ${ok_output} ${ok_error}")
endif()
if(NOT bad EQUAL 1 OR NOT bad_output MATCHES "entity-id")
    message(FATAL_ERROR "Invalid scene was not detected: ${bad} ${bad_output} ${bad_error}")
endif()
if(NOT absent EQUAL 1 OR NOT absent_output MATCHES "missing-asset")
    message(FATAL_ERROR "Missing asset was not detected: ${absent} ${absent_output} ${absent_error}")
endif()
if(NOT exported EQUAL 0 OR NOT EXISTS "${TEST_DIR}/export/scene_gm3d.json" OR NOT EXISTS "${TEST_DIR}/export/scr_gm3d_load_scene.gml")
    message(FATAL_ERROR "CLI export failed: ${exported} ${export_output} ${export_error}")
endif()
